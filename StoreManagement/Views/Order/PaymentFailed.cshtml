@{
    ViewData["Title"] = "Payment Failed";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-x-circle"></i> Payment Failed</h4>
                </div>
                <div class="card-body text-center">
                    <p class="fs-5 mt-3">Your payment could not be processed.</p>
                    <p class="text-muted">@ViewBag.Message</p>

                    <div class="mt-4">
                        <a asp-controller="Order" asp-action="Details" asp-route-id="@ViewBag.OrderId" class="btn btn-primary">
                            <i class="bi bi-arrow-left"></i> Back to Order (Retry Payment)
                        </a>
                        <a asp-controller="Order" asp-action="Index" class="btn btn-secondary ms-2">
                            <i class="bi bi-list"></i> Back to Orders
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>