@model StoreManagement.Models.ViewModels.EditOrderViewModel

@{
    ViewData["Title"] = $"Edit Order #{Model.OrderId}";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square"></i> Edit Order #@Model.OrderId
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" id="orderForm">
                        <input type="hidden" asp-for="OrderId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        @if (TempData["Success"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                @TempData["Success"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerId" class="form-label"></label>
                                <select asp-for="CustomerId" class="form-select" asp-items="Model.Customers">
                                    <option value="">-- Select Customer --</option>
                                </select>
                                <span asp-validation-for="CustomerId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="OrderDate" class="form-label"></label>
                                <input asp-for="OrderDate" class="form-control" type="date" />
                                <span asp-validation-for="OrderDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="EmployeeId" class="form-label"></label>
                                <select asp-for="EmployeeId" class="form-select" asp-items="Model.Staff">
                                    <option value="">-- Select Staff Member --</option>
                                </select>
                                <span asp-validation-for="EmployeeId" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ShipperId" class="form-label"></label>
                                <select asp-for="ShipperId" class="form-select" asp-items="Model.Shippers">
                                    <option value="">-- Select Shipper --</option>
                                </select>
                                <span asp-validation-for="ShipperId" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />

                        <!-- Existing Order Items -->
                        <h5 class="mb-3">
                            <i class="bi bi-box-seam"></i> Current Order Items
                        </h5>

                        @if (Model.ExistingItems != null && Model.ExistingItems.Any())
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="50%">Product</th>
                                            <th width="15%">Unit Price</th>
                                            <th width="15%">Quantity</th>
                                            <th width="15%">Total</th>
                                            <th width="5%"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.ExistingItems)
                                        {
                                            <tr>
                                                <td>@item.ProductName</td>
                                                <td>$@item.UnitPrice?.ToString("N2")</td>
                                                <td>@item.Quantity</td>
                                                <td>$@item.LineTotal.ToString("N2")</td>
                                                <td>
                                                    <form asp-action="DeleteOrderDetail" method="post" style="display:inline;"
                                                          onsubmit="return confirm('Are you sure you want to remove this item?');">
                                                        <input type="hidden" name="orderDetailId" value="@item.OrderDetailId" />
                                                        <input type="hidden" name="orderId" value="@Model.OrderId" />
                                                        <button type="submit" class="btn btn-sm btn-danger" title="Remove">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-info">
                                        <tr>
                                            <td colspan="3" class="text-end"><strong>Existing Items Total:</strong></td>
                                            <td colspan="2">
                                                <strong class="text-success">
                                                    $@Model.ExistingItems.Sum(i => i.LineTotal).ToString("N2")
                                                </strong>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-exclamation-triangle"></i> This order has no items. Add items below.
                            </div>
                        }

                        <hr />

                        <!-- Add New Items -->
                        <h5 class="mb-3">
                            <i class="bi bi-plus-circle"></i> Add New Items
                        </h5>

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label for="productSelect" class="form-label">Product</label>
                                <select id="productSelect" class="form-select">
                                    <option value="">-- Select Product --</option>
                                    @foreach (var product in Model.Products ?? new List<SelectListItem>())
                                    {
                                        <option value="@product.Value" data-price="@product.Text.Split('-').Last().Trim().Replace("$", "")">
                                            @product.Text
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label for="quantityInput" class="form-label">Quantity</label>
                                <input type="number" id="quantityInput" class="form-control" value="1" min="1" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">&nbsp;</label>
                                <button type="button" class="btn btn-success w-100" onclick="addItem()">
                                    <i class="bi bi-plus"></i> Add
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive mb-3">
                            <table class="table table-bordered" id="newItemsTable">
                                <thead class="table-success">
                                    <tr>
                                        <th width="50%">Product</th>
                                        <th width="15%">Unit Price</th>
                                        <th width="15%">Quantity</th>
                                        <th width="15%">Total</th>
                                        <th width="5%"></th>
                                    </tr>
                                </thead>
                                <tbody id="newItemsTableBody">
                                    <tr id="emptyRow">
                                        <td colspan="5" class="text-center text-muted">No new items added yet</td>
                                    </tr>
                                </tbody>
                                <tfoot class="table-success">
                                    <tr>
                                        <td colspan="3" class="text-end"><strong>New Items Total:</strong></td>
                                        <td colspan="2"><strong id="newItemsTotal">$0.00</strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- Grand Total -->
                        <div class="alert alert-info">
                            <div class="row">
                                <div class="col-md-8 text-end">
                                    <h5 class="mb-0">Grand Total (Existing + New Items):</h5>
                                </div>
                                <div class="col-md-4">
                                    <h5 class="mb-0 text-success" id="grandTotal">
                                        $@Model.ExistingItems.Sum(i => i.LineTotal).ToString("N2")
                                    </h5>
                                </div>
                            </div>
                        </div>

                        <input type="hidden" name="itemsJson" id="itemsJson" />

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-circle"></i> Update Order
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <script>
        let newItems = [];
        const existingTotal = @Model.ExistingItems.Sum(i => i.LineTotal);

        function addItem() {
            const productSelect = document.getElementById('productSelect');
            const quantityInput = document.getElementById('quantityInput');

            const productId = parseInt(productSelect.value);
            const quantity = parseInt(quantityInput.value);

            if (!productId || quantity < 1) {
                alert('Please select a product and enter a valid quantity');
                return;
            }

            const selectedOption = productSelect.options[productSelect.selectedIndex];
            const productName = selectedOption.text.split(' - ')[0];
            const priceText = selectedOption.getAttribute('data-price');
            const price = parseFloat(priceText) || 0;

            // Check if product already exists in new items
            const existingItem = newItems.find(i => i.productId === productId);
            if (existingItem) {
                existingItem.quantity += quantity;
            } else {
                newItems.push({
                    productId: productId,
                    quantity: quantity,
                    productName: productName,
                    unitPrice: price
                });
            }

            renderNewItems();

            // Reset inputs
            productSelect.value = '';
            quantityInput.value = 1;
        }

        function removeNewItem(index) {
            newItems.splice(index, 1);
            renderNewItems();
        }

        function renderNewItems() {
            const tbody = document.getElementById('newItemsTableBody');
            const emptyRow = document.getElementById('emptyRow');

            if (newItems.length === 0) {
                tbody.innerHTML = '<tr id="emptyRow"><td colspan="5" class="text-center text-muted">No new items added yet</td></tr>';
                document.getElementById('newItemsTotal').textContent = '$0.00';
                updateGrandTotal(0);
                return;
            }

            if (emptyRow) emptyRow.remove();

            let total = 0;
            tbody.innerHTML = newItems.map((item, index) => {
                const lineTotal = item.unitPrice * item.quantity;
                total += lineTotal;

                return `
                    <tr>
                        <td>${item.productName}</td>
                        <td>$${item.unitPrice.toFixed(2)}</td>
                        <td>${item.quantity}</td>
                        <td>$${lineTotal.toFixed(2)}</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-danger" onclick="removeNewItem(${index})">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');

            document.getElementById('newItemsTotal').textContent = '$' + total.toFixed(2);
            updateGrandTotal(total);
        }

        function updateGrandTotal(newItemsTotal) {
            const grandTotal = existingTotal + newItemsTotal;
            document.getElementById('grandTotal').textContent = '$' + grandTotal.toFixed(2);
        }

        // Before form submit, set items JSON
        document.getElementById('orderForm').addEventListener('submit', function(e) {
            document.getElementById('itemsJson').value = JSON.stringify(newItems);
            console.log('New items being sent:', newItems);
        });
    </script>
}