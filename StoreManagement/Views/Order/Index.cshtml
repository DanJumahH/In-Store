@model StoreManagement.Models.ViewModels.OrderFilterViewModel
@using StoreManagement.Models.Enums

@{
    ViewData["Title"] = "Orders";
}

<div class="container-fluid mt-4">
    <div class="row mb-3">
        <div class="col">
            <h2>
                <i class="bi bi-cart-check"></i> Orders
            </h2>
        </div>
        <div class="col text-end">
            @if (User.IsInRole("Admin") || User.IsInRole("SalesStaff"))
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create New Order
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search and Filter Section -->
    <div class="card mb-3">
        <div class="card-header bg-light">
            <h5 class="mb-0">
                <i class="bi bi-funnel"></i> Search & Filter
                @if (Model.HasActiveFilters())
                {
                    <span class="badge bg-primary ms-2">Active</span>
                }
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <!-- Search Term -->
                    <div class="col-md-3">
                        <label for="SearchTerm" class="form-label">Search</label>
                        <input type="text"
                               class="form-control"
                               id="SearchTerm"
                               name="SearchTerm"
                               value="@Model.SearchTerm"
                               placeholder="Order ID or Customer">
                    </div>

                    <!-- Status Filter -->
                    <div class="col-md-2">
                        <label for="Status" class="form-label">Status</label>
                        <select class="form-select" id="Status" name="Status">
                            <option value="">All Statuses</option>
                            @foreach (var status in Model.StatusOptions ?? new List<SelectListItem>())
                            {
                                <option value="@status.Value" selected="@(Model.Status?.ToString() == status.Value)">
                                    @status.Text
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Staff Filter (Admin Only) -->
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="col-md-3">
                            <label for="StaffId" class="form-label">Staff Member</label>
                            <select class="form-select" id="StaffId" name="StaffId">
                                <option value="">All Staff</option>
                                @foreach (var staff in Model.StaffOptions ?? new List<SelectListItem>())
                                {
                                    <option value="@staff.Value" selected="@(Model.StaffId?.ToString() == staff.Value)">
                                        @staff.Text
                                    </option>
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <!-- Keep layout spacing for non-admins -->
                        <div class="col-md-3"></div>
                    }

                    <!-- Start Date -->
                    <div class="col-md-2">
                        <label for="StartDate" class="form-label">From Date</label>
                        <input type="date"
                               class="form-control"
                               id="StartDate"
                               name="StartDate"
                               value="@Model.StartDate?.ToString("yyyy-MM-dd")">
                    </div>

                    <!-- End Date -->
                    <div class="col-md-2">
                        <label for="EndDate" class="form-label">To Date</label>
                        <input type="date"
                               class="form-control"
                               id="EndDate"
                               name="EndDate"
                               value="@Model.EndDate?.ToString("yyyy-MM-dd")">
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i> Search
                        </button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">
                            <i class="bi bi-x-circle"></i> Clear Filters
                        </a>
                        @if (Model.Orders?.Any() == true)
                        {
                            <span class="ms-3 text-muted">
                                Found <strong>@Model.Orders.Count()</strong> order(s)
                            </span>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Table -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Order ID</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Staff</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th>Items</th>
                            <th>Total Amount</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Orders?.Any() == true)
                        {
                            @foreach (var order in Model.Orders)
                            {
                                <tr>
                                    <td><strong>#@order.OrderId</strong></td>
                                    <td>@order.OrderDate?.ToString("MMM dd, yyyy")</td>
                                    <td>@order.CustomerName</td>
                                    <td>@order.StaffName</td>
                                    <td>
                                        <span class="badge @order.GetStatusBadgeClass()">
                                            @order.Status
                                        </span>
                                        @if (order.StatusUpdatedAt.HasValue)
                                        {
                                            <br />
                                            <small class="text-muted">
                                                @order.StatusUpdatedAt.Value.ToString("MMM dd, h:mm tt")
                                            </small>
                                        }
                                    </td>
                                    <td>
                                        <span class="@order.GetPaymentStatusBadgeClass()">
                                            @order.PaymentStatus
                                        </span>
                                        <br />
                                        <small class="@order.GetPaymentMethodBadge()">
                                            @order.PaymentMethod
                                        </small>
                                    </td>
                                    <td>@order.ItemCount</td>
                                    <td><strong>₦@order.TotalAmount.ToString("N2")</strong></td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@order.OrderId"
                                               class="btn btn-sm btn-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (User.IsInRole("Admin") || User.IsInRole("SalesStaff"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@order.OrderId"
                                                   class="btn btn-sm btn-warning" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>

                                                <a asp-action="Delete" asp-route-id="@order.OrderId"
                                                   class="btn btn-sm btn-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                                    <p class="mt-2">
                                        @if (Model.HasActiveFilters())
                                        {
                                            <text>No orders match your search criteria</text>
                                        }
                                        else
                                        {
                                            <text>No orders found</text>
                                        }
                                    </p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}