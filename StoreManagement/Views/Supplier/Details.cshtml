@model StoreManagement.Models.ViewModels.SupplierViewModel

@{
    ViewData["Title"] = "Supplier Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Supplier Details</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">Company Information</h5>
                            <dl class="row">
                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.SupplierName)</dt>
                                <dd class="col-sm-7">
                                    <strong>@Html.DisplayFor(model => model.SupplierName)</strong>
                                </dd>

                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.ContactName)</dt>
                                <dd class="col-sm-7">
                                    @if (!string.IsNullOrEmpty(Model.ContactName))
                                    {
                                        @Html.DisplayFor(model => model.ContactName)
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </dd>

                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Phone)</dt>
                                <dd class="col-sm-7">
                                    @if (!string.IsNullOrEmpty(Model.Phone))
                                    {
                                        <a href="tel:@Model.Phone">@Html.DisplayFor(model => model.Phone)</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </dd>
                            </dl>
                        </div>

                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">Address Information</h5>
                            <dl class="row">
                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Address)</dt>
                                <dd class="col-sm-7">
                                    @if (!string.IsNullOrEmpty(Model.Address))
                                    {
                                        @Html.DisplayFor(model => model.Address)
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </dd>

                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.City)</dt>
                                <dd class="col-sm-7">@Html.DisplayFor(model => model.City)</dd>

                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.PostalCode)</dt>
                                <dd class="col-sm-7">@Html.DisplayFor(model => model.PostalCode)</dd>

                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Country)</dt>
                                <dd class="col-sm-7">@Html.DisplayFor(model => model.Country)</dd>
                            </dl>
                        </div>
                    </div>

                    <hr />

                    <div class="mb-3">
                        @Html.DisplayNameFor(model => model.ProductCount)
                        @if (Model.ProductCount > 0)
                        {
                            <span class="badge bg-success">@Model.ProductCount Products</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No Products</span>
                        }
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <div>
                            @if (User.IsInRole("Admin") || User.IsInRole("InventoryManager"))
                            {
                                <a asp-action="Edit" asp-route-id="@Model.SupplierId" class="btn btn-warning">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                @if (Model.ProductCount == 0)
                                {
                                    <a asp-action="Delete" asp-route-id="@Model.SupplierId" class="btn btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}