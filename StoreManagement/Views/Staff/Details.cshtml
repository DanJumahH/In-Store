@model StoreManagement.Models.ViewModels.StaffViewModel

@{
    ViewData["Title"] = "Staff Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Staff Member Details</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">Personal Information</h5>
                            <dl class="row">
                                <dt class="col-sm-5">Full Name:</dt>
                                <dd class="col-sm-7">
                                    <strong>@Model.FullName</strong>
                                </dd>

                                <dt class="col-sm-5">Email:</dt>
                                <dd class="col-sm-7">
                                    @if (!string.IsNullOrEmpty(Model.Email))
                                    {
                                        <a href="mailto:@Model.Email">@Model.Email</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </dd>

                                <dt class="col-sm-5">Birth Date:</dt>
                                <dd class="col-sm-7">
                                    @if (Model.BirthDate.HasValue)
                                    {
                                        @Model.BirthDate.Value.ToString("MMMM dd, yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </dd>
                            </dl>
                        </div>

                        <div class="col-md-6">
                            <h5 class="text-primary mb-3">Employment Information</h5>
                            <dl class="row">
                                <dt class="col-sm-5">Role:</dt>
                                <dd class="col-sm-7">
                                    <span class="badge bg-primary">@Model.StaffRole</span>
                                </dd>

                                <dt class="col-sm-5">App Access:</dt>
                                <dd class="col-sm-7">
                                    @if (Model.IsAppUser)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle"></i> Has User Account
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No User Account</span>
                                    }
                                </dd>

                                <dt class="col-sm-5">Orders Processed:</dt>
                                <dd class="col-sm-7">
                                    @if (Model.OrderCount > 0)
                                    {
                                        <span class="badge bg-success">@Model.OrderCount Orders</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No Orders Yet</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <hr />
                        <div class="mb-3">
                            <h5 class="text-primary">Notes</h5>
                            <p class="text-muted">@Model.Notes</p>
                        </div>
                    }

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.StaffId" class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Edit
                            </a>
                            @if (Model.OrderCount == 0)
                            {
                                <a asp-action="Delete" asp-route-id="@Model.StaffId" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}