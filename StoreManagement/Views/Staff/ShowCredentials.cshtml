@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "User Account Created";
    var email = ViewBag.Email as string;
    var password = ViewBag.Password as string;
    var role = ViewBag.Role as string;
    var staffId = ViewBag.StaffId as int?;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="bi bi-check-circle"></i> Staff Member & User Account Created Successfully!</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>IMPORTANT:</strong> Please save these credentials now. This is the only time they will be displayed.
                    </div>

                    <h5 class="mb-3">Login Credentials</h5>

                    <div class="credential-box p-4 bg-light border rounded mb-4">
                        <div class="row mb-3">
                            <div class="col-md-3 fw-bold">Email / Username:</div>
                            <div class="col-md-9">
                                <code class="fs-5">@email</code>
                                <button class="btn btn-sm btn-outline-secondary ms-2" onclick="copyToClipboard('@email')">
                                    <i class="bi bi-clipboard"></i> Copy
                                </button>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-3 fw-bold">Temporary Password:</div>
                            <div class="col-md-9">
                                <code class="fs-5">@password</code>
                                <button class="btn btn-sm btn-outline-secondary ms-2" onclick="copyToClipboard('@password')">
                                    <i class="bi bi-clipboard"></i> Copy
                                </button>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3 fw-bold">Role Assigned:</div>
                            <div class="col-md-9">
                                <span class="badge bg-primary fs-6">@role</span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <h6><i class="bi bi-info-circle"></i> Next Steps:</h6>
                        <ol class="mb-0">
                            <li>Copy or write down these credentials</li>
                            <li>Send credentials via email or share securely</li>
                            <li>Instruct them to log in and change their password on first login</li>
                        </ol>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary" id="actionButtons">
                            <i class="bi bi-arrow-left"></i> Back to Staff List
                        </a>
                        <div id="actionButtons">
                            <button onclick="sendCredentialsEmail(@staffId)" class="btn btn-primary">
                                <i class="bi bi-envelope"></i> Send via Email
                            </button>
                            <button onclick="window.print()" class="btn btn-outline-primary ms-2">
                                <i class="bi bi-printer"></i> Print Credentials
                            </button>
                        </div>

                        <div id="successPanel" class="alert alert-success mt-3" style="display:none;">
                            <i class="bi bi-check-circle"></i> <span id="successMessage"></span>
                            <div class="mt-2">
                                <button onclick="window.location.href='@Url.Action("index")'" class="btn btn-sm btn-success">OK</button>
                            </div>
                        </div>
                        <div id="failedPanel" class="alert alert-danger mt-3" style="display:none;">
                            <i class="bi bi-x-circle"></i> <span id="failedMessage"></span>
                            <div class="mt-2">
                                <button onclick="hideFailedPanel()" class="btn btn-sm btn-danger">Try Again</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                alert('Copied to clipboard!');
            }, function(err) {
                console.error('Could not copy text: ', err);
            });
        }

        function showSuccess(message) {
            document.getElementById('actionButtons').style.display = 'none';
            document.getElementById('successMessage').textContent = message;
            document.getElementById('successPanel').style.display = 'block';
        }
        function showFailed(message) {
            document.getElementById('failedMessage').textContent = message;
            document.getElementById('failedPanel').style.display = 'block';
        }
        function hideFailedPanel() {
            document.getElementById('failedPanel').style.display = 'none';
        }

        function sendCredentialsEmail(staffId) {
            const email = '@email';
            const password = '@password';
            const role = '@role';

            if (!staffId || !email || !password) {
                alert('Missing required information');
                return;
            }

            fetch(`/Staff/SendCredentialsEmail`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    staffId: staffId,
                    email: email,
                    password: password,
                    role: role
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showSuccess(data.message || 'Credentials sent successfully via email!');
                } else {
                    showFailed('Error sending email: ' + (data.message || 'Unknown error'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showFailed('Failed to send email. Please try again.');
            });
        }
    </script>

    <style>
        @@media print {
            .btn, .alert-info {
                display: none !important;
            }
        }
    </style>
}
