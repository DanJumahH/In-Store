@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "User Account Created";
    var email = ViewBag.Email as string;
    var password = ViewBag.Password as string;
    var role = ViewBag.Role as string;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="bi bi-check-circle"></i> Staff Member & User Account Created Successfully!</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>IMPORTANT:</strong> Please save these credentials now. This is the only time they will be displayed.
                    </div>

                    <h5 class="mb-3">Login Credentials</h5>

                    <div class="credential-box p-4 bg-light border rounded mb-4">
                        <div class="row mb-3">
                            <div class="col-md-3 fw-bold">Email / Username:</div>
                            <div class="col-md-9">
                                <code class="fs-5">@email</code>
                                <button class="btn btn-sm btn-outline-secondary ms-2" onclick="copyToClipboard('@email')">
                                    <i class="bi bi-clipboard"></i> Copy
                                </button>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-3 fw-bold">Temporary Password:</div>
                            <div class="col-md-9">
                                <code class="fs-5">@password</code>
                                <button class="btn btn-sm btn-outline-secondary ms-2" onclick="copyToClipboard('@password')">
                                    <i class="bi bi-clipboard"></i> Copy
                                </button>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3 fw-bold">Role Assigned:</div>
                            <div class="col-md-9">
                                <span class="badge bg-primary fs-6">@role</span>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <h6><i class="bi bi-info-circle"></i> Next Steps:</h6>
                        <ol class="mb-0">
                            <li>Copy or write down these credentials</li>
                            <li>Share the email and password with the new staff member securely</li>
                            <li>Instruct them to log in and change their password on first login</li>
                        </ol>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to Staff List
                        </a>
                        <button onclick="window.print()" class="btn btn-outline-primary">
                            <i class="bi bi-printer"></i> Print Credentials
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">

    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                // Show success message
                alert('Copied to clipboard!');
            }, function(err) {
                console.error('Could not copy text: ', err);
            });
        }
    </script>

    <style>
        @@media print {
            .btn, .alert-secondary {
                display: none !important;
            }
        }
    </style>
}
