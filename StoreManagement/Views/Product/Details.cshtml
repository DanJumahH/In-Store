@model StoreManagement.Models.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Product Details";
    // Use Context.Request instead of Request (Request not in scope in some Razor setups).
    var returnUrl = (ViewData["ReturnUrl"] as string) ?? Context.Request.Query["returnUrl"].ToString();
    string backHref;
    if (!string.IsNullOrEmpty(returnUrl) && Url.IsLocalUrl(returnUrl))
    {
        backHref = returnUrl;
    }
    else
    {
        backHref = Url.Action("Index", "Product")!;
    }
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Product Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ProductName)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.ProductName)</dd>

                        <dt class="col-sm-4">Category</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.CategoryName))
                            {
                                <span class="badge bg-primary">@Model.CategoryName</span>
                            }
                            else
                            {
                                <span class="text-muted">Not assigned</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Supplier</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.SupplierName))
                            {
                                <span class="badge bg-success">@Model.SupplierName</span>
                            }
                            else
                            {
                                <span class="text-muted">Not assigned</span>
                            }
                        </dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.UnitStock)</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.UnitStock))
                            {
                                @Html.DisplayFor(model => model.UnitStock)
                            }
                            else
                            {
                                <span class="text-muted">Not specified</span>
                            }
                        </dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Price)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Price))</dd>
                    </dl>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a href="@backHref" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <div>
                            @if (User.IsInRole("Admin") || User.IsInRole("InventoryManager"))
                            {
                                <a asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-warning">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                            }
                            @if (User.IsInRole("Admin") || User.IsInRole("InventoryManager"))
                            {
                                <a asp-action="Delete" asp-route-id="@Model.ProductId" class="btn btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}
