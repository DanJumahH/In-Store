@model StoreManagement.Models.ViewModels.ShipperViewModel

@{
    ViewData["Title"] = "Shipper Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">Shipper Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ShipperName)</dt>
                        <dd class="col-sm-8">
                            <strong>@Html.DisplayFor(model => model.ShipperName)</strong>
                        </dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Phone)</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Phone))
                            {
                                <a href="tel:@Model.Phone">@Html.DisplayFor(model => model.Phone)</a>
                            }
                            else
                            {
                                <span class="text-muted">Not provided</span>
                            }
                        </dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.OrderCount)</dt>
                        <dd class="col-sm-8">
                            @if (Model.OrderCount > 0)
                            {
                                <span class="badge bg-success">@Model.OrderCount Orders</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No Orders Yet</span>
                            }
                        </dd>
                    </dl>

                    <hr />

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                        <div>
                            @if (User.IsInRole("Admin") || User.IsInRole("InventoryManager"))
                            {
                                <a asp-action="Edit" asp-route-id="@Model.ShipperId" class="btn btn-warning">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                @if (Model.OrderCount == 0)
                                {
                                    <a asp-action="Delete" asp-route-id="@Model.ShipperId" class="btn btn-danger">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}