@model StoreManagement.Models.ViewModels.CustomerViewModel

@{
    ViewData["Title"] = "Delete Customer";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Delete Customer</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>Warning!</strong> Are you sure you want to delete this customer?
                    </div>

                    <h5>Customer Information:</h5>

                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.CustomerName)</dt>
                                <dd class="col-sm-7">
                                    <strong>@Html.DisplayFor(model => model.CustomerName)</strong>
                                </dd>

                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.ContactName)</dt>
                                <dd class="col-sm-7">@Html.DisplayFor(model => model.ContactName)</dd>

                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Created)</dt>
                                <dd class="col-sm-7">
                                    @if (Model.Created.HasValue)
                                    {
                                        @Model.Created.Value.ToString("yyyy-MM-dd")
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </dd>
                            </dl>
                        </div>

                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Address)</dt>
                                <dd class="col-sm-7">@Html.DisplayFor(model => model.Address)</dd>

                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.City)</dt>
                                <dd class="col-sm-7">@Html.DisplayFor(model => model.City)</dd>

                                <dt class="col-sm-5">@Html.DisplayNameFor(model => model.Country)</dt>
                                <dd class="col-sm-7">@Html.DisplayFor(model => model.Country)</dd>
                            </dl>
                        </div>
                    </div>

                    <div class="mb-3">
                        <dt>@Html.DisplayNameFor(model => model.OrderCount)</dt>
                        <dd>
                            <span class="badge bg-info">@Model.OrderCount Orders</span>
                        </dd>
                    </div>

                    <hr />

                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CustomerId" />
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Yes, Delete Customer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}